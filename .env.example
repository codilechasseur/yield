# ───────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# docker compose up -d   ← that's it, no extra setup steps needed.
# ───────────────────────────────────────────────────────────────

# The public URL your reverse proxy serves the app on (include https://).
# Required by SvelteKit for CSRF protection — must match what the browser sees.
ORIGIN=https://yield.example.com

# PocketBase superuser credentials.
# Used on first boot to create the admin account, and by the app on every
# request — all PocketBase collections are superuser-only, so the app must be
# able to sign in with these. Use a long random password.
# Changing them later: update the superuser in PocketBase first, then here.
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-this-password

# App UI password.
# Protects the Yield interface with a login screen.
# Set before first boot — it is written to the database automatically on startup.
# After first boot you can remove or blank this line; the DB value persists.
# To change the password later, use Settings → Security inside the app.
APP_PASSWORD=change-this-too

# Client IP header set by your reverse proxy, used to rate-limit login
# attempts per client. Without it every visitor shares the proxy's IP, so
# failed attempts from anyone count against everyone.
# Typical values: X-Forwarded-For (nginx, Traefik, Caddy), CF-Connecting-IP.
# XFF_DEPTH is the number of trusted proxies in front of the app.
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1

# ── Local development only (not used by Docker) ─────────────────────────────
# PB_URL=http://localhost:8090
